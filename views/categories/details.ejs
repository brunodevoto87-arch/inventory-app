<!DOCTYPE html>
<html>
<head>
    <title><%= category.name %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1><%= category.name %></h1>
    <p><%= category.description || "" %></p>
    <a href="/categories/<%= category.id %>/edit" class="btn">Editar</a>
    <a href="/categories/<%= category.id %>/delete" class="btn btn-danger">Eliminar</a>

    <h2>Items en esta categoria</h2>
    <a href="/items/new?category_id=<%= category.id %>" class="btn">+ Nuevo item</a>
    <ul>
        <% items.forEach(item =>{ %>
            <li>
                <a href="/items/<%= item.id %>"><%= item.name %></a>
                - $<%= item.price %> (Stock: <%= item.stock %>)
            </li>
        <% }); %>
    </ul>
</body>
</html>