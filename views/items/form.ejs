<!DOCTYPE html>
<html>
<head>
    <title><%= item?.id ? "Editar" : "Nuevo" %> item</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1><%= item?.id ? "Editar" : "Nuevo" %> item</h1>
    <% if (errors && errors.length > 0){ %>
        <ul class="errors">
            <% errors.forEach(e => { %><li><%= e.msg %></li><% }); %>
        </ul>
    <% } %>
    <form method="POST" action="<%= item?.id ? '/items/'+ item.id + '/edit' : '/items/new' %>">
        <label>Nombre</label>
        <input type="text" name="name" value="<%= item?.name || '' %>" autocomplete="off" required />
        <label>Descripcion</label>
        <textarea name="description" autocomplete="off"><%= item?.description || '' %></textarea>
        <label>Precio ($)</label>
        <input type="number" step="0.01" name="price" value="<%= item?.price || '' %>" required />
        <label>Stock</label>
        <input type="number" name="stock" value="<%= item?.stock || 0 %>" required />
        <label>Categoria</label>
        <select name="category_id">
            <option value="">Sin categoria</option>
            <% categories.forEach(c => { %>
            <option value="<%= c.id %>" <%= item?.category_id === c.id ? 'selected' : '' %>>
                <%= c.name %>
            </option>
        <% }); %>
        </select>
        <button type="submit">Guardar</button>
    </form>
</body>
</html>