<!DOCTYPE html>
<html>
<head>
    <title>Eliminar item</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1>Eliminar item</h1>
    <p>¿Estas seguro?</p>
    <form method="POST" action="/items/<%= item.id %>/delete">
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a href="/items" class="btn">Cancelar</a>
    </form>
</body>
</html>