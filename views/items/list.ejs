<!DOCTYPE html>
<html>
<head>
    <title>Items</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1>Items</h1>
    <a href="/items/new" class="btn">+ Nuevo item</a>
    <ul>
        <% items.forEach(item =>{ %>
            <li>
                <a href="/items/<%= item.id %>"><%= item.name %></a>
                - $<%= item.price %> (Stock: <%= item.stock %>)
                - Categoria: <%= item.category_name || 'Sin categoria' %>
            </li>
         <% }); %>
    </ul>
</body>
</html>